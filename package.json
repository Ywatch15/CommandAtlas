{
  "name": "commandatlas",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run build-content && concurrently -n \"WEB,SERVER\" -c \"cyan.bold,magenta.bold\" \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:server": "npm run start --workspace=apps/server",
    "build": "npm run build-content && npm run build --workspace=apps/web",
    "build-content": "node scripts/build-content.js",
    "build-content:validate": "node scripts/build-content.js --validate-only",
    "test": "node --test scripts/tests/pipeline-stages.test.js scripts/tests/search-engine.test.js scripts/tests/link-graph.test.js apps/server/tests/models.test.js",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.8.0",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
