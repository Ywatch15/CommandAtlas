{
  "name": "commandatlas",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "build-content": "node scripts/build-content.js",
    "build-content:validate": "node scripts/build-content.js --validate-only",
    "test": "node --test scripts/tests/pipeline-stages.test.js scripts/tests/search-engine.test.js scripts/tests/link-graph.test.js",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "eslint": "^9.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.8.0",
    "husky": "^9.1.1",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
