# Supabase / PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commandatlas?schema=public"
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
PORT=3001
CLOSED_BETA_ENABLED=false
BETA_INVITE_KEY=your_beta_invite_key_here

# Gated Service Worker registration (enabled for PWA offline shell caching).
NEXT_PUBLIC_ENABLE_SW=true
